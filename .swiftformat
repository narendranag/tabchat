--swiftversion 6.0
--indent 4
--maxwidth 130
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced
--commas inline
--self remove
--exclude spike,build,Tabchat.xcodeproj,.dashboard
--disable redundantSelf,wrapMultilineStatementBraces,opaqueGenericParameters,wrapConditionalBodies,unusedArguments
